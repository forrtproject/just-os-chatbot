# LLM provider (OpenRouter by default). Switch models with CITATION_MODEL / GENERAL_MODEL.
OPENROUTER_API_KEY="your_openrouter_key"
#CITATION_MODEL=meta-llama/llama-3.1-8b-instruct
#GENERAL_MODEL=meta-llama/llama-3.1-8b-instruct

# Self-hosted OpenScholar (OpenAI-compatible, Bearer key). Calls for OPENSCHOLAR_MODEL
# go to this server; GENERAL_MODEL and other models stay on OpenRouter.
#OPENSCHOLAR_BASE_URL=http://<host>:8080/v1
#OPENSCHOLAR_API_KEY="your_openscholar_key"
#CITATION_MODEL=openscholar-8b
# The CPU server needs minutes for a full answer (prompt + 7 passages); default 600 s
#OPENSCHOLAR_TIMEOUT=600
# Add openscholar-8b to ARENA_MODELS to compare it in the arena.

# Old RUG gateway (all models on one server). Uncomment all four to use it.
#BASE_URL=https://llm.hpc.rug.nl/
#LLM_API_KEY="your_rug_llm_key"
#CITATION_MODEL=openscholar
#GENERAL_MODEL=default-chat

# Arena page /arena: two anonymous models side by side, with votes.
# One LLM call per model per question. Models: ARENA_MODELS (comma separated).
ARENA_ENABLED=true
#ARENA_MODELS=meta-llama/llama-3.1-8b-instruct,openai/gpt-oss-20b

# Development setup without a symlink (works on Windows). Production: compose.yaml:compose.prod.yaml
COMPOSE_FILE=compose.yaml:compose.dev.yaml
COMPOSE_PATH_SEPARATOR=:
DOCKER_WEB_PORT_FORWARD=127.0.0.1:8000

# 1 worker: each worker loads its own copy of the models and index (about 3 GB RAM)
WEB_CONCURRENCY=1
WEB_RELOAD=true
# Seconds per request. An arena question waits for two models.
WEB_TIMEOUT=300
UNPAYWALL_EMAIL="your_email_adress"
